# Copy to .env next to docker-compose.yml. Everything here is optional and
# commented out, so the server runs with the file as is. Uncomment what you need.

# Sign-in. Without a password Kaodoku runs single-user with no login. With one,
# this admin can't be edited in the app and manages other users and roles.
# KAODOKU_ADMIN_USER=admin
# KAODOKU_ADMIN_PASSWORD=change-me

# Encrypts stored secrets such as tracker tokens: 64 hex characters, for example
# from `openssl rand -hex 32`. Unset = a kaodoku.key is generated next to the database.
# KAODOKU_ENCRYPTION_KEY=

# FlareSolverr, for Cloudflare-protected sites. Also uncomment the flaresolverr
# service in docker-compose.yml.
# KAODOKU_BROWSER_SOLVER_ENABLED=true
# KAODOKU_BROWSER_SOLVER_ENDPOINT=http://flaresolverr:8191/v1
# KAODOKU_BROWSER_SOLVER_TIMEOUT_SECONDS=60

# Headless-browser worker, for sites whose readers need JavaScript. Also
# uncomment the selenium and browser-worker services in docker-compose.yml.
# KAODOKU_BROWSER_DOWNLOADER_ENABLED=true
# KAODOKU_BROWSER_DOWNLOADER_ENDPOINT=http://browser-worker:8192
# KAODOKU_BROWSER_DOWNLOADER_TIMEOUT_SECONDS=180
# Makes the browser-worker accept only requests with this key. Compose passes
# it to the browser-worker and kotatsu-worker as well.
# KAODOKU_BROWSER_DOWNLOADER_API_KEY=change-me

# Kotatsu sidecar for extra sources (see kotatsu-worker/README.md). Also
# uncomment the kotatsu-worker service in docker-compose.yml. The key is
# required; compose gives it to the worker too.
# KAODOKU_KOTATSU_WORKER_ENABLED=true
# KAODOKU_KOTATSU_WORKER_ENDPOINT=http://kotatsu-worker:8484
# KAODOKU_KOTATSU_WORKER_API_KEY=change-me

# OIDC single sign-on. Needs KAODOKU_ADMIN_PASSWORD, which stays available as a
# break-glass login. Register Kaodoku at your identity provider with the
# redirect URI https://<your-host>/auth/oidc/callback.
# KAODOKU_OIDC_ISSUER=https://auth.example.com
# KAODOKU_OIDC_CLIENT_ID=kaodoku
# KAODOKU_OIDC_CLIENT_SECRET=change-me
# Set when Kaodoku runs behind a reverse proxy:
# KAODOKU_OIDC_REDIRECT_URL=https://kaodoku.example.com/auth/oidc/callback
# Create accounts on first SSO login (otherwise an admin links them on the Users page):
# KAODOKU_OIDC_AUTO_PROVISION=true
# Hold auto-provisioned accounts as pending until someone with the users.approve
# permission approves them on the Users page:
# KAODOKU_OIDC_REQUIRE_APPROVAL=true
# KAODOKU_OIDC_DEFAULT_ROLE=member
# Map identity-provider groups or roles to Kaodoku roles, re-synced on every
# login. Keycloak realm roles use the nested path realm_access.roles.
# KAODOKU_OIDC_ROLE_CLAIM=groups
# KAODOKU_OIDC_ROLE_MAP=kaodoku-admins:admin,kaodoku-users:member
# Extra scopes when your provider gates claims behind one (openid is always requested):
# KAODOKU_OIDC_SCOPES=profile email groups
# Claim for provisioned usernames (falls back to email, then sub):
# KAODOKU_OIDC_USERNAME_CLAIM=preferred_username

# Paths. docker-compose.yml points these at its volumes, so they only matter
# when running the binary directly.
# KAODOKU_DB=./kaodoku.db
# KAODOKU_DOWNLOAD_DIR=./downloads
# XDG_CONFIG_HOME=./config
